#!/usr/bin/env bash
# Refuse commits whose Rust files aren't rustfmt-clean.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.rs$'; then
    if ! cargo fmt --all -- --check >/dev/null 2>&1; then
        echo "pre-commit: Rust code is not rustfmt-clean. Run 'cargo fmt', re-stage, and commit again." >&2
        exit 1
    fi
fi
